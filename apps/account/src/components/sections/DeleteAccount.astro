---
import { t, type Locale } from '../../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = t(locale).deleteAccount;
---

<form
  class="form"
  data-delete-account
  data-api={Astro.locals.apiUrl}
  data-errors={JSON.stringify(dict.errors)}
  novalidate
>
  <div class="notice">
    <p>{dict.warning}</p>
  </div>
  <label class="field">
    <span>{dict.password}</span>
    <input
      type="password"
      name="password"
      autocomplete="current-password"
      required
      aria-describedby="password-error"
    />
    <span class="field-error" id="password-error" data-error-for="password" hidden></span>
  </label>
  <div class="field field-check">
    <label>
      <input type="checkbox" name="confirm" required aria-describedby="confirm-error" />
      <span>{dict.confirm}</span>
    </label>
    <span class="field-error" id="confirm-error" data-error-for="confirm" hidden></span>
  </div>
  <p class="form-error" role="alert" data-error-for="form" hidden></p>
  <button class="button form-submit" type="submit">
    {dict.submit}
  </button>
</form>

<section class="form-done" data-deleted hidden>
  <h2 tabindex="-1">{dict.done}</h2>
  <p>{dict.doneBody}</p>
  <a href={`https://stairno.com/${locale}/`}>{dict.hub}</a>
</section>

<script>
  import { deleteError } from '../../lib/delete-form';

  const form = document.querySelector<HTMLFormElement>('[data-delete-account]');
  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const { api = '', errors = '{}' } = form.dataset;
    const text = JSON.parse(errors) as Record<string, string>;
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');

    // NFR-17: at most one message per field, as text next to it.
    const show = (found: Partial<Record<'password' | 'confirm' | 'form', string>>) => {
      for (const slot of form.querySelectorAll<HTMLElement>('[data-error-for]')) {
        const key = found[slot.dataset.errorFor as 'password' | 'confirm' | 'form'];
        slot.textContent = key ? (text[key] ?? '') : '';
        slot.hidden = !key;
        form
          .querySelector(`[name="${slot.dataset.errorFor}"]`)
          ?.setAttribute('aria-invalid', key ? 'true' : 'false');
      }
    };

    const data = new FormData(form);
    const password = String(data.get('password') ?? '');
    const local = {
      ...(password ? {} : { password: 'passwordMissing' }),
      ...(data.get('confirm') === 'on' ? {} : { confirm: 'confirm' }),
    };
    show(local);
    if (Object.keys(local).length > 0) return;

    if (button) button.disabled = true;
    try {
      // FR-8: deleted at once; the API also ends every session.
      const res = await fetch(`${api}/auth/delete-user`, {
        method: 'POST',
        credentials: 'include',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ password }),
      });
      if (res.ok) {
        const done = document.querySelector<HTMLElement>('[data-deleted]');
        form.hidden = true;
        document.querySelector<HTMLElement>('.account-menu')?.setAttribute('hidden', '');
        if (done) done.hidden = false;
        done?.querySelector('h2')?.focus();
        return;
      }
      const reply = (await res.json().catch(() => null)) as { code?: string } | null;
      const { field, key } = deleteError(res.status, reply?.code);
      show({ [field]: key });
    } catch {
      show({ form: 'unavailable' });
    }
    if (button) button.disabled = false;
  });
</script>
