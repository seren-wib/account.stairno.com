---
import { t, type Locale } from '../../i18n';
import { formatDate } from '../../lib/api';
import type { Download } from '../../lib/account-data';

interface Props {
  locale: Locale;
  /** null when the list could not be read. */
  downloads: Download[] | null;
}

const { locale, downloads } = Astro.props;
const dict = t(locale).downloads;
// FR-84: dates in the user's time zone, UTC when none is set.
const tz = Astro.locals.user?.timezone;
---

<div class="page-stack">
  <p class="form-note">{dict.intro}</p>
  <p
    class="form-error"
    role="alert"
    data-downloads-error
    data-api={Astro.locals.apiUrl}
    data-failed={dict.failed}
    hidden
  ></p>
  {downloads === null ? (
    <p class="form-error">{dict.unavailable}</p>
  ) : downloads.length === 0 ? (
    <p class="status">{dict.empty}</p>
  ) : (
    <ul class="item-list">
      {downloads.map((item) => (
        <li class="item">
          <div>
            <p class="item-title">{item.name[locale]}</p>
            {item.expiresAt && (
              <p class="item-meta">
                {dict.until} {formatDate(item.expiresAt, locale, tz)}
              </p>
            )}
          </div>
          <button class="item-action" type="button" data-download-sku={item.sku}>
            {dict.download}
          </button>
        </li>
      ))}
    </ul>
  )}
</div>

<script>
  const error = document.querySelector<HTMLElement>('[data-downloads-error]');

  // FR-62: a ten-minute link from the API; following it starts the download.
  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-download-sku]')) {
    button.addEventListener('click', async () => {
      button.disabled = true;
      try {
        const res = await fetch(`${error?.dataset.api}/v1/downloads`, {
          method: 'POST',
          credentials: 'include',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ sku: button.dataset.downloadSku }),
        });
        if (res.ok) {
          const { url } = (await res.json()) as { url: string };
          window.location.assign(url);
        } else if (error) {
          error.textContent = error.dataset.failed ?? '';
          error.hidden = false;
        }
      } catch {
        if (error) {
          error.textContent = error.dataset.failed ?? '';
          error.hidden = false;
        }
      }
      button.disabled = false;
    });
  }
</script>
