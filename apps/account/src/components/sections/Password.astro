---
import { t, type Locale } from '../../i18n';

interface Props {
  locale: Locale;
  /** The page came back from a change: say so once. */
  changed?: boolean;
}

const { locale, changed = false } = Astro.props;
const dict = t(locale).password;
---

<form
  class="form"
  data-change-password
  data-api={Astro.locals.apiUrl}
  data-errors={JSON.stringify(dict.errors)}
  novalidate
>
  {changed && (
    <p class="status" role="status">
      {dict.done}
    </p>
  )}
  <label class="field">
    <span>{dict.current}</span>
    <input
      type="password"
      name="currentPassword"
      autocomplete="current-password"
      required
      aria-describedby="currentPassword-error"
    />
    <span
      class="field-error"
      id="currentPassword-error"
      data-error-for="currentPassword"
      hidden
    ></span>
  </label>
  <label class="field">
    <span>{dict.new}</span>
    <input
      type="password"
      name="newPassword"
      autocomplete="new-password"
      minlength="8"
      maxlength="128"
      required
      aria-describedby="newPassword-hint newPassword-error"
    />
    <span class="field-hint" id="newPassword-hint">
      {dict.hint}
    </span>
    <span class="field-error" id="newPassword-error" data-error-for="newPassword" hidden></span>
  </label>
  <p class="form-error" role="alert" data-error-for="form" hidden></p>
  <button class="button form-submit" type="submit">
    {dict.submit}
  </button>
</form>

<script>
  import {
    passwordChangeError,
    passwordChangeInput,
    type PasswordErrorKey,
    type PasswordField,
  } from '../../lib/password-form';

  // The confirmation is in the address only for the reload; keep it out of history.
  if (new URLSearchParams(window.location.search).has('password')) {
    window.history.replaceState(null, '', `${window.location.pathname}${window.location.hash}`);
  }

  const form = document.querySelector<HTMLFormElement>('[data-change-password]');
  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const { api = '', errors = '{}' } = form.dataset;
    const text = JSON.parse(errors) as Record<PasswordErrorKey, string>;
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');

    // NFR-17: at most one message per field, as text next to it.
    const show = (found: Partial<Record<PasswordField | 'form', PasswordErrorKey>>) => {
      for (const slot of form.querySelectorAll<HTMLElement>('[data-error-for]')) {
        const key = found[slot.dataset.errorFor as PasswordField | 'form'];
        slot.textContent = key ? text[key] : '';
        slot.hidden = !key;
        form
          .querySelector(`[name="${slot.dataset.errorFor}"]`)
          ?.setAttribute('aria-invalid', key ? 'true' : 'false');
      }
    };

    const data = new FormData(form);
    const currentPassword = String(data.get('currentPassword') ?? '');
    const newPassword = String(data.get('newPassword') ?? '');
    const local = passwordChangeInput(currentPassword, newPassword);
    show(local);
    if (Object.keys(local).length > 0) return;

    if (button) button.disabled = true;
    try {
      // FR-83: the API ends every other session and gives this browser a fresh one.
      const res = await fetch(`${api}/auth/change-password`, {
        method: 'POST',
        credentials: 'include',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ currentPassword, newPassword }),
      });
      if (res.ok) {
        // Reload so the notice shows once; the device list on the account page is fresh too.
        window.location.assign(`${window.location.pathname}?password=changed`);
        return;
      }
      const reply = (await res.json().catch(() => null)) as { code?: string } | null;
      const { field, key } = passwordChangeError(res.status, reply?.code);
      show({ [field]: key });
    } catch {
      show({ form: 'unavailable' });
    }
    if (button) button.disabled = false;
  });
</script>
