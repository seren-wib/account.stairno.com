---
import { countries } from '@stairno-account/contract';
import { locales, t, type Locale } from '../../i18n';

interface Props {
  locale: Locale;
  /** The name and language on the account page, or the email change on its own page (FR-30). */
  part: 'profile' | 'email';
}

const { locale, part } = Astro.props;
const dict = t(locale).profile;
const user = Astro.locals.user;
const api = Astro.locals.apiUrl;
// FR-84: countries named in the page language and sorted by that name; IANA time zones.
const regionNames = new Intl.DisplayNames(locale, { type: 'region' });
const countryOptions = countries
  .map((code) => ({ code, name: regionNames.of(code) ?? code }))
  .sort((a, b) => a.name.localeCompare(b.name, locale));
const zones = Intl.supportedValuesOf('timeZone');
const timeZones = zones.includes('UTC') ? zones : ['UTC', ...zones];
const messages = JSON.stringify({ saved: dict.saved, emailSent: dict.emailSent, ...dict.errors });
// FR-85: the photo, or the first letter of the name (as the header's account menu shows it).
const initial = Array.from((user?.name || user?.email || '').trim())[0]?.toLocaleUpperCase(locale);
const photoMessages = JSON.stringify({
  photoTooBig: dict.photoTooBig,
  photoType: dict.photoType,
  photoFailed: dict.photoFailed,
});
---

{part === 'profile' && (
  <div class="photo-row" data-photo data-api={api} data-messages={photoMessages}>
    {user?.image ? (
      <img class="avatar" src={user.image} alt={dict.photo} width="72" height="72" />
    ) : (
      <span class="avatar avatar-initial" data-photo-initial aria-hidden="true">
        {initial}
      </span>
    )}
    <div class="photo-actions">
      <div class="button-row">
        <label class="item-action photo-change">
          {dict.photoChange}
          <input
            class="visually-hidden"
            type="file"
            accept="image/png,image/jpeg,image/webp"
            data-photo-input
          />
        </label>
        {user?.image && (
          <button class="item-action" type="button" data-photo-remove>
            {dict.photoRemove}
          </button>
        )}
      </div>
      <p class="field-hint">{dict.photoHint}</p>
      <p class="form-error" role="alert" data-photo-error hidden></p>
    </div>
  </div>
)}

{part === 'profile' && (
  <form class="form" data-profile data-api={api} data-messages={messages} novalidate>
    <label class="field">
      <span>{dict.name}</span>
      <input
        name="name"
        autocomplete="name"
        value={user?.name}
        required
        aria-describedby="name-error"
      />
      <span class="field-error" id="name-error" data-error-for="name" hidden></span>
    </label>
    <label class="field">
      <span>{dict.language}</span>
      <select name="locale">
        {locales.map((option) => (
          <option value={option} selected={user?.locale === option}>
            {dict.languages[option]}
          </option>
        ))}
      </select>
    </label>
    <label class="field">
      <span>{dict.country}</span>
      <select name="country" autocomplete="country">
        <option value="" selected={!user?.country}>
          {dict.notSet}
        </option>
        {countryOptions.map((option) => (
          <option value={option.code} selected={user?.country === option.code}>
            {option.name}
          </option>
        ))}
      </select>
    </label>
    <label class="field">
      <span>{dict.timezone}</span>
      <select name="timezone">
        <option value="" selected={!user?.timezone}>
          {dict.notSet}
        </option>
        {timeZones.map((zone) => (
          <option value={zone} selected={user?.timezone === zone}>
            {zone}
          </option>
        ))}
      </select>
    </label>
    <p class="form-note" role="status" data-result></p>
    <button class="button form-submit" type="submit">
      {dict.save}
    </button>
  </form>
)}

{part === 'email' && (
  <form class="form" data-change-email data-api={api} data-messages={messages} novalidate>
    <dl class="detail-list">
      <div>
        <dt>{dict.currentEmail}</dt>
        <dd>{user?.email}</dd>
      </div>
    </dl>
    <label class="field">
      <span>{dict.newEmail}</span>
      <input
        type="email"
        name="newEmail"
        autocomplete="email"
        required
        aria-describedby="newEmail-hint newEmail-error"
      />
      <span class="field-hint" id="newEmail-hint">
        {dict.emailPending}
      </span>
      <span class="field-error" id="newEmail-error" data-error-for="newEmail" hidden></span>
    </label>
    <p class="form-note" role="status" data-result></p>
    <button class="button form-submit" type="submit">
      {dict.changeEmail}
    </button>
  </form>
)}

<script>
  import { profileUpdateSchema } from '@stairno-account/contract';
  import { PHOTO_SIZE, PHOTO_TYPES, photoError, squareCrop } from '../../lib/photo-form';

  // FR-85: the browser cuts the picture to its centred square at 256 px and sends that; the
  // page reloads to show it. WebP where the browser can write it, PNG otherwise.
  const photo = document.querySelector<HTMLElement>('[data-photo]');
  if (photo) {
    const { api = '', messages = '{}' } = photo.dataset;
    const text = JSON.parse(messages) as Record<ReturnType<typeof photoError>, string>;
    const error = photo.querySelector<HTMLElement>('[data-photo-error]');
    const fail = (message: string) => {
      if (!error) return;
      error.textContent = message;
      error.hidden = false;
    };
    const blobOf = (canvas: HTMLCanvasElement, type: string) =>
      new Promise<Blob | null>((resolve) => canvas.toBlob(resolve, type, 0.9));

    async function send(init: RequestInit) {
      error?.setAttribute('hidden', '');
      try {
        const res = await fetch(`${api}/v1/me/image`, { credentials: 'include', ...init });
        if (res.ok) {
          window.location.reload();
          return;
        }
        fail(text[photoError(res.status)]);
      } catch {
        fail(text.photoFailed);
      }
    }

    const input = photo.querySelector<HTMLInputElement>('[data-photo-input]');
    input?.addEventListener('change', async () => {
      const file = input.files?.[0];
      input.value = '';
      if (!file) return;
      if (!(PHOTO_TYPES as readonly string[]).includes(file.type)) return fail(text.photoType);
      try {
        const bitmap = await createImageBitmap(file);
        const { x, y, size } = squareCrop(bitmap.width, bitmap.height);
        const canvas = document.createElement('canvas');
        canvas.width = PHOTO_SIZE;
        canvas.height = PHOTO_SIZE;
        canvas.getContext('2d')?.drawImage(bitmap, x, y, size, size, 0, 0, PHOTO_SIZE, PHOTO_SIZE);
        let blob = await blobOf(canvas, 'image/webp');
        if (!blob || blob.type !== 'image/webp') blob = await blobOf(canvas, 'image/png');
        if (!blob) return fail(text.photoFailed);
        await send({ method: 'PUT', headers: { 'content-type': blob.type }, body: blob });
      } catch {
        fail(text.photoType);
      }
    });

    const remove = photo.querySelector<HTMLButtonElement>('[data-photo-remove]');
    remove?.addEventListener('click', () => {
      remove.disabled = true;
      void send({ method: 'DELETE' }).finally(() => {
        remove.disabled = false;
      });
    });
  }

  type Messages = Record<
    'saved' | 'emailSent' | 'name' | 'email' | 'unavailable' | 'tooMany',
    string
  >;

  function parts(form: HTMLFormElement) {
    const { api = '', messages = '{}' } = form.dataset;
    return {
      api,
      text: JSON.parse(messages) as Messages,
      result: form.querySelector<HTMLElement>('[data-result]'),
      button: form.querySelector<HTMLButtonElement>('button[type="submit"]'),
    };
  }

  // NFR-17: one message next to the field, or none.
  function fieldError(form: HTMLFormElement, field: string, message: string | null) {
    const slot = form.querySelector<HTMLElement>(`[data-error-for="${field}"]`);
    const input = form.querySelector<HTMLElement>(`[name="${field}"]`);
    if (slot) {
      slot.textContent = message ?? '';
      slot.hidden = !message;
    }
    input?.setAttribute('aria-invalid', message ? 'true' : 'false');
    if (message) input?.focus();
  }

  async function post(api: string, path: string, body: unknown) {
    return fetch(`${api}/auth/${path}`, {
      method: 'POST',
      credentials: 'include',
      headers: { 'content-type': 'application/json' },
      body: JSON.stringify(body),
    });
  }

  // FR-6: name and language. A new language reloads the page in that language.
  const profile = document.querySelector<HTMLFormElement>('[data-profile]');
  profile?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const { api, text, result, button } = parts(profile);
    const data = new FormData(profile);
    const parsed = profileUpdateSchema.safeParse({
      name: data.get('name'),
      locale: data.get('locale'),
      // FR-84: "not set" clears the value.
      country: data.get('country') || null,
      timezone: data.get('timezone') || null,
    });
    fieldError(profile, 'name', parsed.success ? null : text.name);
    if (!parsed.success) return;

    if (button) button.disabled = true;
    let message = text.unavailable;
    try {
      const res = await post(api, 'update-user', parsed.data);
      if (res.ok) {
        const current = window.location.pathname.split('/')[1];
        if (current !== parsed.data.locale) {
          window.location.assign(`/${parsed.data.locale}/#profile`);
          return;
        }
        message = text.saved;
      } else if (res.status === 429) {
        message = text.tooMany;
      }
    } catch {
      // The API is unreachable.
    }
    if (result) result.textContent = message;
    if (button) button.disabled = false;
  });

  // FR-6: the new address is confirmed first; the current one stays until then.
  const changeEmail = document.querySelector<HTMLFormElement>('[data-change-email]');
  changeEmail?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const { api, text, result, button } = parts(changeEmail);
    const newEmail = String(new FormData(changeEmail).get('newEmail') ?? '').trim();
    const valid = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(newEmail);
    fieldError(changeEmail, 'newEmail', valid ? null : text.email);
    if (!valid) return;

    if (button) button.disabled = true;
    let message = text.unavailable;
    try {
      const res = await post(api, 'change-email', { newEmail });
      if (res.ok) message = text.emailSent;
      else if (res.status === 429) message = text.tooMany;
      else if (res.status === 400) {
        fieldError(changeEmail, 'newEmail', text.email);
        message = '';
      }
    } catch {
      // The API is unreachable.
    }
    if (result) result.textContent = message;
    if (button) button.disabled = false;
  });
</script>
