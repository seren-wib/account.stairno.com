---
// The frame of every signed-in page (SDD §7.1): the page menu beside the content. The header's
// account menu (FR-82) comes from Base, which reads the user the session guard put in locals.
import Base from './Base.astro';
import { localePath, t, type Locale } from '../i18n';

export type AccountPage = 'overview' | 'profile' | 'devices' | 'connections' | 'delete';

interface Props {
  locale: Locale;
  page: AccountPage;
  heading: string;
}

const { locale, page, heading } = Astro.props;
const dict = t(locale).account;

// First phase only; payment methods, orders, subscriptions and downloads come with the second.
const items: { page: AccountPage; path: string }[] = [
  { page: 'overview', path: '' },
  { page: 'profile', path: 'profile' },
  { page: 'devices', path: 'devices' },
  { page: 'connections', path: 'connections' },
  { page: 'delete', path: 'delete' },
];
const current = items.find((item) => item.page === page);
---

<Base locale={locale} path={current?.path ?? ''} heading={heading}>
  <div class="account-grid">
    <nav class="account-menu" aria-label={dict.menuLabel}>
      <ul>
        {items.map((item) => (
          <li>
            <a
              href={localePath(locale, item.path)}
              aria-current={item.page === page ? 'page' : undefined}
            >
              {dict.menu[item.page]}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <div class="account-content">
      <slot />
    </div>
  </div>
</Base>
