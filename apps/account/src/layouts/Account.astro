---
// The frame of every signed-in page (SDD §7.1): five categories beside the content. The menu stays
// put while the page's sections scroll, and lists those sections under the current category. The
// header's account menu (FR-82) comes from Base, which reads the user the session guard put in
// locals.
import Base from './Base.astro';
import { localePath, t, type Locale } from '../i18n';

export type AccountPage = 'home' | 'security' | 'billing' | 'library' | 'account';

export interface SectionLink {
  id: string;
  label: string;
}

interface Props {
  locale: Locale;
  page: AccountPage;
  heading: string;
  /** The page's sections, in order, for the links under the current category. */
  sections?: SectionLink[];
  /** Passed to Base: hosts this page's browser code calls besides the API (NFR-7). */
  connect?: string[];
  /** Path below the locale prefix, for the locale switch. Defaults to the category's own. */
  path?: string;
}

const { locale, page, heading, sections = [], connect } = Astro.props;
const dict = t(locale).account;

const items: { page: AccountPage; path: string }[] = [
  { page: 'home', path: '' },
  { page: 'security', path: 'security' },
  { page: 'billing', path: 'billing' },
  { page: 'library', path: 'library' },
  { page: 'account', path: 'account' },
];
const current = items.find((item) => item.page === page);
const path = Astro.props.path ?? current?.path ?? '';
---

<Base locale={locale} path={path} heading={heading} connect={connect}>
  <div class="account-grid">
    <nav class="account-menu" aria-label={dict.menuLabel}>
      <ul>
        {items.map((item) => (
          <li>
            <a
              href={localePath(locale, item.path)}
              aria-current={item.page === page ? 'page' : undefined}
            >
              {dict.menu[item.page]}
            </a>
            {item.page === page && sections.length > 0 && (
              <ul class="account-submenu">
                {sections.map((section) => (
                  <li>
                    <a href={`#${section.id}`}>{section.label}</a>
                  </li>
                ))}
              </ul>
            )}
          </li>
        ))}
      </ul>
    </nav>
    <div class="account-content">
      <slot />
    </div>
  </div>
</Base>
