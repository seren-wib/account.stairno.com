---
import AccountMenu from '@stairno/ui/components/AccountMenu.astro';
import Fonts from '@stairno/ui/components/Fonts.astro';
import Footer from '@stairno/ui/components/Footer.astro';
import Header from '@stairno/ui/components/Header.astro';
import ThemeInit from '@stairno/ui/components/ThemeInit.astro';
import '@stairno/ui/base.css';
import '../styles/account.css';
import { localePath, t, type Locale } from '../i18n';
import { HUB_ORIGIN } from '../lib/redirect';
import { connectSrc } from '../lib/security-headers';

interface Props {
  locale: Locale;
  /** Path below the locale prefix, for the locale switch. */
  path?: string;
  /** The page heading in the night band, and the start of the <title>. */
  heading: string;
  /** Frame the content in one card that overlaps the night band (auth pages, FR-27). */
  card?: boolean;
  /** Hosts this page's browser code calls besides the API (NFR-7), such as Toss's SDK. */
  connect?: string[];
}

const { locale, path = '', heading, card = false, connect = [] } = Astro.props;
const dict = t(locale);
// NFR-7: browser code on these pages calls the API, and a page's own hosts, and nothing else.
Astro.csp?.insertDirective(connectSrc(Astro.locals.apiUrl, connect));
const title = heading === dict.meta.title ? heading : `${heading} · ${dict.meta.title}`;
// FR-82: the session guard puts the user in locals on signed-in pages; elsewhere the menu is
// signed out (auth and legal pages never call the API for it).
const user = Astro.locals.user
  ? { name: Astro.locals.user.name, email: Astro.locals.user.email }
  : null;
// DR-7: the brand's home is the hub; the overview is under the account menu and the side menu.
const hubHome = `${HUB_ORIGIN}/${locale}/`;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <ThemeInit />
    <title>{title}</title>
    <meta name="description" content={dict.meta.description} />
    <meta name="robots" content="noindex" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <Fonts />
  </head>
  <body>
    <Header
      locale={locale}
      path={path}
      brand="Stairno"
      brandHref={hubHome}
      switchLabel={dict.nav.switchLocale}
      themeLabels={dict.nav.theme}
    >
      <Fragment slot="actions">
        <AccountMenu
          locale={locale}
          labels={dict.nav.accountMenu}
          accountUrl={localePath(locale, '')}
          signInUrl={localePath(locale, 'sign-in')}
          signUpUrl={localePath(locale, 'sign-up')}
          signOutUrl={`${Astro.locals.apiUrl}/auth/sign-out`}
          user={user}
        />
      </Fragment>
    </Header>
    <main>
      <section class="page-head">
        <div class="container">
          <h1>{heading}</h1>
        </div>
      </section>
      {card ? (
        <div class="page-body page-body-card container">
          <div class="card">
            <slot />
          </div>
        </div>
      ) : (
        <div class="page-body container">
          <slot />
        </div>
      )}
    </main>
    <Footer
      locale={locale}
      path={path}
      brand="Stairno"
      links={{
        heading: dict.footer.heading,
        // DR-7: the account center links back to the hub and nowhere else of Stairno.
        items: [{ href: hubHome, label: dict.footer.hub }],
      }}
      source={{
        href: 'https://github.com/seren-wib/account.stairno.com',
        label: dict.footer.source,
      }}
      switchLabel={dict.nav.switchLocale}
    />
  </body>
</html>
