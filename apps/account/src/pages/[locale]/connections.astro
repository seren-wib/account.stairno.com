---
import Connections from '../../components/sections/Connections.astro';
import Account from '../../layouts/Account.astro';
import { isLocale, t } from '../../i18n';
import { apiGet } from '../../lib/api';
import type { Connection } from '../../lib/account-data';

const { locale } = Astro.params;
if (!locale || !isLocale(locale)) return Astro.rewrite('/404');
const dict = t(locale).connections;

// FR-21
const list = await apiGet<{ items: Connection[] }>(Astro.locals, Astro.request, '/v1/connections');
---

<Account locale={locale} page="connections" heading={dict.heading}>
  <Connections locale={locale} connections={list?.items ?? null} />
</Account>
