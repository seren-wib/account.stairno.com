---
import Account from '../../layouts/Account.astro';
import { isLocale, t } from '../../i18n';
import { apiGet, formatDate } from '../../lib/api';

const { locale } = Astro.params;
if (!locale || !isLocale(locale)) return Astro.rewrite('/404');
const dict = t(locale).devices;

interface Session {
  id: string;
  createdAt: string;
  lastUsedAt: string;
  browser: string | null;
  os: string | null;
  current: boolean;
}

// FR-7
const list = await apiGet<{ items: Session[] }>(Astro.locals, Astro.request, '/v1/sessions');
const sessions = list?.items ?? null;
const label = (s: Session) => [s.browser, s.os].filter(Boolean).join(' · ') || dict.unknown;
const messages = JSON.stringify({ unavailable: dict.unavailable });
---

<Account locale={locale} page="devices" heading={dict.heading}>
  {sessions === null ? (
    <p class="form-error">{dict.unavailable}</p>
  ) : (
    <>
      <ul class="item-list" data-api={Astro.locals.apiUrl} data-messages={messages}>
        {sessions.map((session) => (
          <li class="item">
            <div>
              <p class="item-title">
                {label(session)}
                {session.current && <span class="badge">{dict.current}</span>}
              </p>
              <p class="item-meta">
                {dict.signedIn} {formatDate(session.createdAt, locale)} · {dict.lastUsed}{' '}
                {formatDate(session.lastUsedAt, locale)}
              </p>
            </div>
            {!session.current && (
              <button class="item-action" type="button" data-end-session={session.id}>
                {dict.end}
              </button>
            )}
          </li>
        ))}
      </ul>
      {sessions.length > 1 && (
        <div class="notice">
          <p>{dict.othersBody}</p>
          <button
            class="button form-submit"
            type="button"
            data-sign-out-others
            data-api={Astro.locals.apiUrl}
          >
            {dict.signOutOthers}
          </button>
        </div>
      )}
      <p class="form-error" role="alert" data-devices-error hidden />
    </>
  )}
</Account>

<script>
  const list = document.querySelector<HTMLElement>('[data-messages]');
  const error = document.querySelector<HTMLElement>('[data-devices-error]');
  const { unavailable = '' } = JSON.parse(list?.dataset.messages ?? '{}') as {
    unavailable?: string;
  };

  // Runs the request; on success the server renders the new list.
  async function act(button: HTMLButtonElement, request: () => Promise<Response>) {
    button.disabled = true;
    try {
      if ((await request()).ok) {
        window.location.reload();
        return;
      }
    } catch {
      // The API is unreachable.
    }
    if (error) {
      error.textContent = unavailable;
      error.hidden = false;
    }
    button.disabled = false;
  }

  // FR-7: end one other session.
  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-end-session]')) {
    button.addEventListener('click', () =>
      act(button, () =>
        fetch(`${list?.dataset.api}/v1/sessions/${button.dataset.endSession}`, {
          method: 'DELETE',
          credentials: 'include',
        }),
      ),
    );
  }

  // FR-4: every session but this one.
  const others = document.querySelector<HTMLButtonElement>('[data-sign-out-others]');
  others?.addEventListener('click', () =>
    act(others, () =>
      fetch(`${others.dataset.api}/auth/revoke-other-sessions`, {
        method: 'POST',
        credentials: 'include',
        headers: { 'content-type': 'application/json' },
        body: '{}',
      }),
    ),
  );
</script>
