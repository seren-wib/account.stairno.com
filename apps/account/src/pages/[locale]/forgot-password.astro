---
import Base from '../../layouts/Base.astro';
import { isLocale, localePath, t } from '../../i18n';

const { locale } = Astro.params;
if (!locale || !isLocale(locale)) return Astro.rewrite('/404');
const dict = t(locale).forgotPassword;
const messages = JSON.stringify({ tooMany: dict.tooMany, unavailable: dict.unavailable });
---

<Base locale={locale} path="forgot-password" heading={dict.heading} card>
  <noscript>
    <p class="form-note">{dict.noscript}</p>
  </noscript>
  <form
    class="form"
    data-forgot-password
    data-api={Astro.locals.apiUrl}
    data-messages={messages}
    novalidate
  >
    <p class="form-note">{dict.intro}</p>
    <label class="field">
      <span>{dict.email}</span>
      <input type="email" name="email" autocomplete="email" required />
    </label>
    <p class="form-error" role="alert" data-error hidden></p>
    <button class="button form-submit" type="submit">
      {dict.submit}
    </button>
  </form>

  <section class="form-done" data-sent hidden>
    <h2 tabindex="-1">{dict.sent}</h2>
    <p>{dict.sentBody}</p>
  </section>

  <p class="form-links">
    <a href={localePath(locale, 'sign-in')}>{dict.backToSignIn}</a>
  </p>
</Base>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-forgot-password]');
  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const { api = '', messages = '{}' } = form.dataset;
    const text = JSON.parse(messages) as Record<'tooMany' | 'unavailable', string>;
    const error = form.querySelector<HTMLElement>('[data-error]');
    const button = form.querySelector<HTMLButtonElement>('button');
    if (error) error.hidden = true;
    if (button) button.disabled = true;
    let message = text.unavailable;
    try {
      const res = await fetch(`${api}/auth/request-password-reset`, {
        method: 'POST',
        credentials: 'include',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ email: new FormData(form).get('email') }),
      });
      // FR-5: the same answer whether or not the address has an account.
      if (res.ok || res.status === 400) {
        const sent = document.querySelector<HTMLElement>('[data-sent]');
        form.hidden = true;
        if (sent) sent.hidden = false;
        sent?.querySelector('h2')?.focus();
        return;
      }
      if (res.status === 429) message = text.tooMany;
    } catch {
      // The API is unreachable.
    }
    if (error) {
      error.textContent = message;
      error.hidden = false;
    }
    if (button) button.disabled = false;
  });
</script>
