---
import AccountCategory from '../../components/AccountCategory.astro';
import AccountSection from '../../components/AccountSection.astro';
import Connections from '../../components/sections/Connections.astro';
import DeleteAccount from '../../components/sections/DeleteAccount.astro';
import Devices from '../../components/sections/Devices.astro';
import Downloads from '../../components/sections/Downloads.astro';
import Orders from '../../components/sections/Orders.astro';
import PaymentMethods from '../../components/sections/PaymentMethods.astro';
import Profile from '../../components/sections/Profile.astro';
import SignIn from '../../components/sections/SignIn.astro';
import Subscriptions from '../../components/sections/Subscriptions.astro';
import Account from '../../layouts/Account.astro';
import { isLocale, localePath, t } from '../../i18n';
import { apiGet } from '../../lib/api';
import {
  canAddCard,
  type CardList,
  type Connection,
  type Download,
  type Session,
  type Subscription,
} from '../../lib/account-data';
import type { Order } from '../../lib/orders';
import { TOSS_CONNECT_SRC, TOSS_SDK_URL } from '../../lib/toss';

// FR-29 (SRS 3.5, 2026-10-18): the whole account on one page. Account, Billing, Library and
// Security, top to bottom; account deletion is the very end.
const { locale } = Astro.params;
if (!locale || !isLocale(locale)) return Astro.rewrite('/404');
const dict = t(locale);

// Every list at once, so the page waits for the slowest one only (DR-1: the API, with the cookie).
const [cards, subscriptions, orders, downloads, sessions, connections] = await Promise.all([
  apiGet<CardList>(Astro.locals, Astro.request, '/v1/payment-methods'),
  apiGet<{ items: Subscription[] }>(Astro.locals, Astro.request, '/v1/subscriptions'),
  apiGet<{ items: Order[] }>(Astro.locals, Astro.request, '/v1/me/orders?limit=5'),
  apiGet<{ items: Download[] }>(Astro.locals, Astro.request, '/v1/me/downloads'),
  apiGet<{ items: Session[] }>(Astro.locals, Astro.request, '/v1/sessions'),
  apiGet<{ items: Connection[] }>(Astro.locals, Astro.request, '/v1/connections'),
]);

// NFR-7: Toss's SDK, and Toss in the CSP, only where the card window can actually open.
// The first inserted resource replaces Astro's default 'self' instead of joining it, so 'self'
// goes back in by hand (checked in the built page, 2026-10-18).
const canAdd = canAddCard(cards, Astro.locals.user?.emailVerified ?? false);
if (canAdd) {
  Astro.csp?.insertScriptResource("'self'");
  Astro.csp?.insertScriptResource(new URL(TOSS_SDK_URL).origin);
}
---

<Account locale={locale} heading={dict.overview.heading} connect={canAdd ? TOSS_CONNECT_SRC : []}>
  <AccountCategory id="account" title={dict.account.menu.account}>
    <AccountSection id="profile" title={dict.profile.heading}>
      <Profile locale={locale} part="profile" />
    </AccountSection>
    <AccountSection id="sign-in" title={dict.account.signIn}>
      <SignIn locale={locale} />
    </AccountSection>
  </AccountCategory>

  <AccountCategory id="billing" title={dict.account.menu.billing}>
    <AccountSection id="payment-methods" title={dict.paymentMethods.heading}>
      <PaymentMethods locale={locale} list={cards} />
    </AccountSection>
    <AccountSection id="subscriptions" title={dict.subscriptions.heading}>
      <Subscriptions locale={locale} subscriptions={subscriptions?.items ?? null} />
    </AccountSection>
    <AccountSection id="orders" title={dict.orders.recent}>
      <Orders
        locale={locale}
        orders={orders?.items ?? null}
        more={localePath(locale, 'orders')}
        moreLabel={dict.orders.all}
      />
    </AccountSection>
  </AccountCategory>

  <AccountCategory id="library" title={dict.account.menu.library}>
    <AccountSection id="downloads" title={dict.downloads.heading}>
      <Downloads locale={locale} downloads={downloads?.items ?? null} />
    </AccountSection>
  </AccountCategory>

  <AccountCategory id="security" title={dict.account.menu.security}>
    <AccountSection id="devices" title={dict.devices.heading}>
      <Devices locale={locale} sessions={sessions?.items ?? null} />
    </AccountSection>
    <AccountSection id="connections" title={dict.connections.heading}>
      <Connections locale={locale} connections={connections?.items ?? null} />
    </AccountSection>
    <AccountSection id="delete-account" title={dict.deleteAccount.heading} danger>
      <DeleteAccount locale={locale} />
    </AccountSection>
  </AccountCategory>
</Account>
