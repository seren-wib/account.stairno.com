---
import Base from '../../layouts/Base.astro';
import { isLocale, t } from '../../i18n';

const { locale } = Astro.params;
if (!locale || !isLocale(locale)) return Astro.rewrite('/404');
const dict = t(locale);
---

<Base locale={locale} heading={dict.meta.title}>
  <p>{Astro.locals.user?.name}</p>
</Base>
