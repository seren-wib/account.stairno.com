---
import AccountSection from '../../components/AccountSection.astro';
import Downloads from '../../components/sections/Downloads.astro';
import Account from '../../layouts/Account.astro';
import { isLocale, t } from '../../i18n';
import { apiGet } from '../../lib/api';
import type { Download } from '../../lib/account-data';

const { locale } = Astro.params;
if (!locale || !isLocale(locale)) return Astro.rewrite('/404');
const dict = t(locale);

// FR-62: what the user may download now. The link itself is made on the click, so it is fresh.
const list = await apiGet<{ items: Download[] }>(Astro.locals, Astro.request, '/v1/me/downloads');

const sections = [{ id: 'downloads', label: dict.downloads.heading }];
---

<Account locale={locale} page="library" heading={dict.account.menu.library} sections={sections}>
  <AccountSection id="downloads" title={dict.downloads.heading}>
    <Downloads locale={locale} downloads={list?.items ?? null} />
  </AccountSection>
</Account>
