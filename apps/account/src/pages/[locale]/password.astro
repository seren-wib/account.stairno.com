---
import Password from '../../components/sections/Password.astro';
import Account from '../../layouts/Account.astro';
import { isLocale, localePath, t } from '../../i18n';

// FR-83, FR-30: the account page links here from the password under sign-in details.
const { locale } = Astro.params;
if (!locale || !isLocale(locale)) return Astro.rewrite('/404');
const dict = t(locale);
---

<Account locale={locale} current="account" path="password" heading={dict.password.heading}>
  <div class="page-stack">
    <Password locale={locale} changed={Astro.url.searchParams.get('password') === 'changed'} />
    <a href={`${localePath(locale, '')}#sign-in`}>{dict.account.back}</a>
  </div>
</Account>
