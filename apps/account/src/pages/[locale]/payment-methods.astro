---
import { isLocale } from '../../i18n';
import { movedTo } from '../../lib/moved';

// FR-30: this page is now a section of a category page (SRS 3.5, 2026-10-18).
const { locale } = Astro.params;
if (!locale || !isLocale(locale)) return Astro.rewrite('/404');
return Astro.redirect(movedTo(locale, 'payment-methods', Astro.url.search), 301);
---
