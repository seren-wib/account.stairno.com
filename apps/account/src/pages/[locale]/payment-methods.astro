---
import PaymentMethods from '../../components/sections/PaymentMethods.astro';
import Account from '../../layouts/Account.astro';
import { isLocale, t } from '../../i18n';
import { apiGet } from '../../lib/api';
import { canAddCard, type CardList } from '../../lib/account-data';
import { TOSS_CONNECT_SRC, TOSS_SDK_URL } from '../../lib/toss';

const { locale } = Astro.params;
if (!locale || !isLocale(locale)) return Astro.rewrite('/404');
const dict = t(locale).paymentMethods;

// FR-45, FR-53
const list = await apiGet<CardList>(Astro.locals, Astro.request, '/v1/payment-methods');
// NFR-7: Toss's SDK, and Toss in the CSP, only where the card window can actually open.
// The first inserted resource replaces Astro's default 'self' instead of joining it, so 'self'
// goes back in by hand (checked in the built page, 2026-10-18).
const canAdd = canAddCard(list, Astro.locals.user?.emailVerified ?? false);
if (canAdd) {
  Astro.csp?.insertScriptResource("'self'");
  Astro.csp?.insertScriptResource(new URL(TOSS_SDK_URL).origin);
}
---

<Account
  locale={locale}
  page="paymentMethods"
  heading={dict.heading}
  connect={canAdd ? TOSS_CONNECT_SRC : []}
>
  <PaymentMethods locale={locale} list={list} />
</Account>
