---
import Base from '../../layouts/Base.astro';
import { isLocale, localePath, t } from '../../i18n';

const { locale } = Astro.params;
if (!locale || !isLocale(locale)) return Astro.rewrite('/404');
const dict = t(locale).resetPassword;
// The link in the reset mail (FR-5) carries the token.
const token = Astro.url.searchParams.get('token') ?? '';
const forgotHref = localePath(locale, 'forgot-password');
---

<Base locale={locale} path="reset-password" heading={dict.heading} card>
  {token ? (
    <>
      <noscript>
        <p class="form-note">{dict.noscript}</p>
      </noscript>
      <form
        class="form"
        data-reset-password
        data-api={Astro.locals.apiUrl}
        data-token={token}
        data-errors={JSON.stringify(dict.errors)}
        novalidate
      >
        <label class="field">
          <span>{dict.password}</span>
          <input
            type="password"
            name="password"
            autocomplete="new-password"
            minlength="8"
            maxlength="128"
            required
            aria-describedby="password-hint password-error"
          />
          <span class="field-hint" id="password-hint">
            {dict.passwordHint}
          </span>
          <span class="field-error" id="password-error" data-error-for="password" hidden />
        </label>
        <p class="form-error" role="alert" data-error-for="form" hidden />
        <p class="form-links" data-request-again hidden>
          <a href={forgotHref}>{dict.requestAgain}</a>
        </p>
        <button class="button form-submit" type="submit">
          {dict.submit}
        </button>
      </form>
      <section class="form-done" data-done hidden>
        <h2 tabindex="-1">{dict.done}</h2>
        <p>{dict.doneBody}</p>
        <a class="button form-submit" href={localePath(locale, 'sign-in')}>
          {dict.signIn}
        </a>
      </section>
    </>
  ) : (
    <section class="form-done">
      <p class="form-error">{dict.errors.expired}</p>
      <a href={forgotHref}>{dict.requestAgain}</a>
    </section>
  )}
</Base>

<script>
  import { resetError } from '../../lib/reset-form';

  const form = document.querySelector<HTMLFormElement>('[data-reset-password]');
  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const { api = '', token = '', errors = '{}' } = form.dataset;
    const text = JSON.parse(errors) as Record<string, string>;
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    const fieldError = form.querySelector<HTMLElement>('[data-error-for="password"]');
    const formError = form.querySelector<HTMLElement>('[data-error-for="form"]');
    const again = form.querySelector<HTMLElement>('[data-request-again]');
    const input = form.querySelector<HTMLInputElement>('[name="password"]');
    const show = (slot: HTMLElement | null, message: string) => {
      if (fieldError) fieldError.hidden = true;
      if (formError) formError.hidden = true;
      if (slot) {
        slot.textContent = message;
        slot.hidden = false;
      }
      input?.setAttribute('aria-invalid', slot === fieldError ? 'true' : 'false');
    };

    const password = input?.value ?? '';
    if (password.length < 8 || password.length > 128) {
      show(fieldError, text.passwordLength ?? '');
      input?.focus();
      return;
    }

    if (button) button.disabled = true;
    try {
      const res = await fetch(`${api}/auth/reset-password`, {
        method: 'POST',
        credentials: 'include',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ token, newPassword: password }),
      });
      if (res.ok) {
        const done = document.querySelector<HTMLElement>('[data-done]');
        form.hidden = true;
        if (done) done.hidden = false;
        done?.querySelector('h2')?.focus();
        return;
      }
      const reply = (await res.json().catch(() => null)) as { code?: string } | null;
      const key = resetError(res.status, reply?.code);
      const onField = key === 'passwordLength' || key === 'passwordBreached';
      show(onField ? fieldError : formError, text[key] ?? '');
      if (again) again.hidden = key !== 'expired';
    } catch {
      show(formError, text.unavailable ?? '');
    }
    if (button) button.disabled = false;
  });
</script>
