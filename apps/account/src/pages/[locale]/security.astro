---
import AccountSection from '../../components/AccountSection.astro';
import Connections from '../../components/sections/Connections.astro';
import Devices from '../../components/sections/Devices.astro';
import Password from '../../components/sections/Password.astro';
import Account from '../../layouts/Account.astro';
import { isLocale, t } from '../../i18n';
import { apiGet } from '../../lib/api';
import type { Connection, Session } from '../../lib/account-data';

const { locale } = Astro.params;
if (!locale || !isLocale(locale)) return Astro.rewrite('/404');
const dict = t(locale);

// FR-83 needs nothing read. FR-7, FR-21: both lists at once, so the page waits for the slower one only.
const [sessions, connections] = await Promise.all([
  apiGet<{ items: Session[] }>(Astro.locals, Astro.request, '/v1/sessions'),
  apiGet<{ items: Connection[] }>(Astro.locals, Astro.request, '/v1/connections'),
]);

const sections = [
  { id: 'password', label: dict.password.heading },
  { id: 'devices', label: dict.devices.heading },
  { id: 'connections', label: dict.connections.heading },
];
---

<Account locale={locale} page="security" heading={dict.account.menu.security} sections={sections}>
  <AccountSection id="password" title={dict.password.heading}>
    <Password locale={locale} changed={Astro.url.searchParams.get('password') === 'changed'} />
  </AccountSection>
  <AccountSection id="devices" title={dict.devices.heading}>
    <Devices locale={locale} sessions={sessions?.items ?? null} />
  </AccountSection>
  <AccountSection id="connections" title={dict.connections.heading}>
    <Connections locale={locale} connections={connections?.items ?? null} />
  </AccountSection>
</Account>
