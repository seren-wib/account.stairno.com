---
import Subscriptions from '../../components/sections/Subscriptions.astro';
import Account from '../../layouts/Account.astro';
import { isLocale, t } from '../../i18n';
import { apiGet } from '../../lib/api';
import type { Subscription } from '../../lib/account-data';

const { locale } = Astro.params;
if (!locale || !isLocale(locale)) return Astro.rewrite('/404');
const dict = t(locale).subscriptions;

// FR-32, FR-56. The API decides what each subscription may do; the page only shows it.
const list = await apiGet<{ items: Subscription[] }>(
  Astro.locals,
  Astro.request,
  '/v1/subscriptions',
);
---

<Account locale={locale} page="subscriptions" heading={dict.heading}>
  <Subscriptions locale={locale} subscriptions={list?.items ?? null} />
</Account>
