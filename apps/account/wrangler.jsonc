{
  "name": "stairno-account",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // Cloudflare creates the DNS record and certificate on deploy (test and deploy document §8.1).
  "routes": [{ "pattern": "account.stairno.com", "custom_domain": true }],
  "vars": {
    "PUBLIC_API_URL": "https://api.stairno.com",
  },
  "observability": { "enabled": true },
}
