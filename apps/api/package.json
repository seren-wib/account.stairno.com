{
  "name": "@stairno-account/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run --outdir dist",
    "check": "tsc --noEmit && tsc --noEmit -p tests",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "db:migrate": "drizzle-kit migrate",
    "auth:schema": "auth generate --config ./auth.schema.ts --output src/db/schema/auth.ts -y && prettier --write src/db/schema/auth.ts"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261016.1",
    "@electric-sql/pglite": "^0.5.10",
    "@types/node": "^22.20.5",
    "auth": "1.7.10",
    "drizzle-kit": "^0.31.11",
    "postgres": "^3.4.9",
    "wrangler": "^4.151.1"
  },
  "dependencies": {
    "@better-auth/oauth-provider": "1.7.10",
    "@neondatabase/serverless": "^1.2.0",
    "better-auth": "1.7.10",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13"
  }
}
