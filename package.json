{
  "name": "account.stairno.com",
  "version": "0.4.1",
  "private": true,
  "description": "Stairno Account: sign-in, account center and the shared API",
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace apps/api",
    "build": "npm run build --workspaces --if-present",
    "check": "npm run check --workspaces --if-present && tsc --noEmit -p e2e",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "vitest run --config e2e/vitest.config.ts",
    "db:check": "npm run db:check --workspace apps/api",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "drizzle-orm": "^0.45.4",
    "postgres": "^3.4.9",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "typescript": "^5.9.0",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.1"
  }
}
